{
  "name": "parrplumbing",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "parrplumbing.com", "custom_domain": true },
    { "pattern": "www.parrplumbing.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
